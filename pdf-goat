#!/bin/sh
# Launcher for pdf-goat. Runs the CLI inside its uv-managed environment,
# syncing dependencies on first use.
set -eu
# Self-locating: resolve the symlink in ~/.local/bin back to this launcher with
# one readlink call so the project works no matter where it's cloned.
self="$(readlink -f -- "$0")"
dir="${self%/*}"
venv="$dir/.venv"
stamp="$venv/.synced"
# uv's environment check costs ~14 ms of a ~50 ms floor, so run it only when
# the manifest changed since the last sync or the environment is missing.
if [ ! -x "$venv/bin/pdf-goat-cli" ] || [ ! -e "$stamp" ] \
  || [ "$dir/uv.lock" -nt "$stamp" ] \
  || [ "$dir/pyproject.toml" -nt "$stamp" ]; then
  uv sync --project "$dir" --quiet
  touch "$stamp"
fi
export VIRTUAL_ENV="$venv" PATH="$venv/bin:$PATH"
exec "$venv/bin/pdf-goat-cli" "$@"
